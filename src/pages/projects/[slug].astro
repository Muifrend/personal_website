---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const LINK_CLASS =
  "text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1";

const normalizeExternalUrl = (value?: string) => {
  const trimmed = value?.trim();

  if (!trimmed) {
    return null;
  }

  try {
    const parsed = new URL(trimmed);

    if (!parsed.protocol.match(/^https?:$/)) {
      return null;
    }

    return parsed.toString();
  } catch {
    return null;
  }
};

const normalizeInternalPath = (value?: string) => {
  const trimmed = value?.trim();

  if (!trimmed) {
    return null;
  }

  if (
    trimmed.startsWith("//") ||
    /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(trimmed)
  ) {
    return null;
  }

  return trimmed.startsWith("/") ? trimmed : `/${trimmed}`;
};

const buildLinkLabel = (value?: string, fallback = "Link") =>
  value?.trim() || fallback;

// 1. Generate a path for every project
export async function getStaticPaths() {
  const projects = await getCollection("projectsCollection");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, repo, link_url, link_file, link_text, date, cover } = entry.data;

const repoHref = normalizeExternalUrl(repo);
const externalLinkHref = normalizeExternalUrl(link_url);
const internalLinkHref = externalLinkHref ? null : normalizeInternalPath(link_file);
const hasProjectLink = Boolean(externalLinkHref || internalLinkHref);
const hasAnyLink = Boolean(repoHref || hasProjectLink);
const projectLinkLabel = buildLinkLabel(
  link_text,
  internalLinkHref ? "View File" : "Visit Site",
);

const parsedDate = date ? new Date(date) : null;
const formattedDate =
  parsedDate && !Number.isNaN(parsedDate.valueOf())
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "2-digit",
        year: "numeric",
      }).format(parsedDate)
    : "Date unavailable";
---

<Layout title={title}>
  <main class="max-w-3xl py-12 mx-auto pt-20 px-6 w-full">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3 leading-tight">
      {title}
    </h1>
    {
      hasAnyLink && (
        <div class="border-gray-200 pb-6">
          <div class="flex items-center gap-4 text-m font-medium">
            {repoHref && (
              <a
                href={repoHref}
                target="_blank"
                rel="noopener noreferrer"
                class={LINK_CLASS}
              >
                Github Repo
              </a>
            )}

            {repoHref && hasProjectLink && <span class="text-gray-300">|</span>}

            {externalLinkHref && (
              <a
                href={externalLinkHref}
                target="_blank"
                rel="noopener noreferrer"
                class={LINK_CLASS}
              >
                {projectLinkLabel}
              </a>
            )}

            {internalLinkHref && (
              <a href={internalLinkHref} class={LINK_CLASS}>
                {projectLinkLabel}
              </a>
            )}
          </div>
        </div>
      )
    }
    <p class="text-gray-500 text-sm mb-8 font-mono">{formattedDate}</p>

    <hr class="border-gray-200 mb-8" />
    {
      cover && (
        <Image
          src={cover}
          alt={title}
          class="w-full h-auto rounded-xl shadow-lg mb-8 border border-gray-500"
          loading="eager"
        />
      )
    }
    <article class="prose prose-gray prose-lg max-w-none">
      <Content />
    </article>
  </main>
</Layout>
