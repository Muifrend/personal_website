---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
// 1. Generate a path for every project
export async function getStaticPaths() {
  const projects = await getCollection("projectsCollection");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, repo, link_url, link_file, link_text, date, cover } = entry.data;
---

<Layout title={title}>
  <main class="max-w-3xl py-12 mx-auto pt-20 px-6 w-full">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3 leading-tight">
      {title}
    </h1>
    {
      (repo || link_url || link_file) && (
        <div class=" border-gray-200 pb-6">
          <div class="flex items-center gap-4 text-m font-medium">
            {/* Render Repo Link if it exists */}
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1"
              >
                Github Repo
              </a>
            )}

            {/* Add a separator if BOTH exist */}
            {repo && (link_url || link_file) && (
              <span class="text-gray-300">|</span>
            )}

            {/* Render Website Link if it exists */}
            {(link_url || link_file) && (
              <a
                href={link_url || link_file}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1"
              >
                {link_text || "Link"}
              </a>
            )}
          </div>
        </div>
      )
    }
    <p class="text-gray-500 text-sm mb-8 font-mono">
      {date.toDateString()}
    </p>

    <hr class="border-gray-200 mb-8" />
    {
      cover && (
        <Image
          src={cover}
          alt={title}
          class="w-full h-auto rounded-xl shadow-lg mb-8 border border-gray-500"
          loading="eager"
        />
      )
    }
    <article class="prose prose-gray prose-lg max-w-none">
      <Content />
    </article>
  </main>
</Layout>
