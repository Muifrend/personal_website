---
import Hero from "../features/home/Hero.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../features/home/Contact.astro";
import Gallery from "../features/gallery/Gallery";
import { getGalleryImages } from "../lib/galleryImages";

const { photos, places } = await getGalleryImages();
---

<Layout title="Home" description="Personal website of Andrzej Firek (Andrew), featuring software projects, AI agents, automation, writing, and ways to connect.">
  <div class="pt-4 sm:pt-12">
    <Hero places={places} />
    <section>
      <Gallery client:load photos={photos} />
    </section>
    <Contact />
  </div>
</Layout>
