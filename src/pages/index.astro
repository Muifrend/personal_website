---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import HorizontalGallery from '../components/HorizontalGallery';

const altMap: Record<string, string> = {
  // exact filename  :  description
  "Mumbai_India.jpg": "On the streets of Mumbai, India",
  "New_York_City_US.jpg": "NYSE, USA",
  "San_Francisco_US.jpg": "Oracle Park San Francisco, USA",
  "Taipei_Taiwan.jpg": "Cityscape of Taipei, Taiwan",
  "Great_Wall_Of_China.jpg": "The Great Wall of China", 
  "Tel_Aviv_Israel.jpg": "On the streets of Tel Aviv, Israel",
  "Cruise_Mazury_Poland.jpg": "Cruising the Mazury Lakes in Poland",
  "Youtube_HQ_US.jpg": "YouTube Headquarters Visit, USA"
};
const matches = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpeg,jpg,png,gif}', { eager: true });

const galleryImages = Object.values(matches).map((image) => {
  const url = image.default.src;

  // 1. Loop through your map keys (e.g., "Mumbai_India.jpg")
  const foundKey = Object.keys(altMap).find((key) => {
    // 2. Remove the extension to get just the name: "Mumbai_India"
    const namePart = key.split('.')[0]; 
    
    // 3. Check if the URL contains "Mumbai_India"
    return url.includes(namePart);
  });

  return {
    src: url,
    // 4. Use the key if found, otherwise fallback
    alt: foundKey ? altMap[foundKey] : "Gallery Image"
  };
});

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Home">
  <div class="py-12">
    <Welcome />
    <section class="site-container">
      <h2 class="text-3xl md:text-4xl font-bold pt-8 mb-4">Travels</h2>
      <HorizontalGallery client:load photos={galleryImages} />
    </section>
    <Contact />
  </div>
</Layout>
