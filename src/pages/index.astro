---
import Hero from "../features/home/Hero.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../features/home/Contact.astro";
import Gallery from "../features/gallery/Gallery";
import { galleryPhotos } from "../data/galleryPhotos";
---

<Layout title="Home">
  <div class="py-12">
    <Hero />
    <section class="site-container">
      <h2 class="text-2xl md:text-3xl leading-snug pt-8 mb-4">
        <span class="font-light">Inspired by </span><span class="font-bold"
          >people</span
        ><span class="font-light">, </span><span class="font-bold">places</span
        ><span class="font-light"> &amp; </span><span class="font-bold"
          >problems</span
        ><span class="font-light"> worth solving</span>
      </h2>
      <Gallery client:load photos={galleryPhotos} />
    </section>
    <Contact />
  </div>
</Layout>
