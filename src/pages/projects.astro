---
import Layout from "../layouts/Layout.astro";
import ProjectBrowser from "../features/projects/ProjectBrowser";
import {
  getProjectTags,
  sortProjectsByDate,
  toProjectListItem,
} from "../features/projects/projectFormatters";
import { getCollection } from "astro:content";

const allProjects = sortProjectsByDate(
  await getCollection("projectsCollection"),
);
const allTags = getProjectTags(allProjects);
const formattedProjects = allProjects.map(toProjectListItem);
---

<Layout title="Projects" description="Explore Andrzej Firek's software projects, including AI agents, workflow automation, Chrome extensions, and machine learning research.">
  <div class="py-16">
    <h1 class="pt-12 pb-8 text-5xl font-bold md:text-6xl">
      Projects
    </h1>
    <ProjectBrowser
      client:load
      projects={formattedProjects}
      allTags={allTags}
    />
  </div>
</Layout>
