---
import Layout from "../layouts/Layout.astro";
import ProjectBrowser from "../features/projects/ProjectBrowser";
import {
  getProjectTags,
  sortProjectsByDate,
  toProjectListItem,
} from "../features/projects/projectFormatters";
import { getCollection } from "astro:content";

const allProjects = sortProjectsByDate(
  await getCollection("projectsCollection"),
);
const allTags = getProjectTags(allProjects);
const formattedProjects = allProjects.map(toProjectListItem);
---

<Layout title="Projects">
  <div class="py-16">
    <h1 class="max-w-7xl sm:text-5xl md:text-6xl mx-auto w-full pt-12 pb-8 text-4xl font-bold">
      Projects
    </h1>
    <ProjectBrowser
      client:load
      projects={formattedProjects}
      allTags={allTags}
    />
  </div>
</Layout>
