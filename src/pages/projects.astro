---
import Layout from "../layouts/Layout.astro";
import ProjectBrowser from "../components/ProjectBrowser";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const allTags = [
  ...new Set(allProjects.flatMap((project) => project.data.tags || [])),
].sort();

const formattedProjects = allProjects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  date: p.data.date.toISOString(),
  tags: p.data.tags || [], // Ensure tags is an array
}));
---

<Layout title="Projects">
  <main class="max-w-6xl mx-auto px-6 py-16 w-full">
    <h1 class="max-w-7xl mx-auto w-full pt-12 pb-8 text-6xl font-bold">
      Projects
    </h1>
    <ProjectBrowser
      client:load
      projects={formattedProjects}
      allTags={allTags}
    />
  </main>
</Layout>
