---
const pathname = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const currentPath = normalizePath(pathname);

const links = [
  // MOBILE LINKS
  { 
    href: "/", 
    label: "ANDREW_FIREK", 
    mobileOnly: true,
    class: "sm:hidden font-mono text-black text-sm font-bold tracking-tighter" 
  },
  { 
    href: "/projects", 
    label: "Projects", 
    mobileOnly: true,
    class: "sm:hidden font-mono text-sm" 
  },
  
  // DESKTOP LINKS
  { href: "/", label: "Home", key: "H", desktopOnly: true },
  { href: "/projects", label: "Projects", key: "P", desktopOnly: true },
  { href: "/feeling-lucky", label: "I'm Feeling Lucky", key: "F", desktopOnly: true },
];
---

<nav class="site-nav bg-white/80">
  <div class="site-container h-14 flex items-center">
    <ul class="flex items-center justify-between sm:justify-center w-full sm:w-auto sm:mx-auto gap-1 list-none px-4 sm:px-0">
      {
        links.map((link) => (
          <li class:list={[
            { "hidden sm:block": link.desktopOnly },
            { "block sm:hidden": link.mobileOnly }
          ]}>
            <a
              href={link.href}
              class:list={[
                link.mobileOnly ? link.class : "group nav-link",
                { active: currentPath === normalizePath(link.href) },
              ]}
            >
              {/* Symbols hidden on mobile via 'hidden sm:inline-block' */}
              {link.key && <span class="nav-key hidden sm:inline-block">{link.key}</span>}
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const routes: Record<string, string> = {
    h: "/",
    p: "/projects",
    f: "/feeling-lucky",
  };

  window.addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

    const target = routes[e.key.toLowerCase()];
    if (target) {
      e.preventDefault();
      window.location.href = target;
    }
  });
</script>