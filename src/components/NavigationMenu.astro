---
// 1. Get the current path directly from Astro (Server-side)
const pathname = Astro.url.pathname;

// 2. Helper to remove trailing slashes for comparison
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const currentPath = normalizePath(pathname);

const links = [
  { href: "/", label: "Home", key: "H" },
  { href: "/projects", label: "Projects", key: "P" },
  { href: "/feeling-lucky", label: "I'm Feeling Lucky", key: "F" },
];
---

<nav class="site-nav bg-white/80">
  <div class="site-container h-14 flex items-center">
    <ul class="flex items-center gap-1 mx-auto list-none">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "group nav-link",
                { active: currentPath === normalizePath(link.href) },
              ]}
            >
              <span class="nav-key">{link.key}</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // This script is tiny and runs instantly without React
  const routes: Record<string, string> = {
    h: "/",
    p: "/projects",
    f: "/feeling-lucky",
  };

  window.addEventListener("keydown", (e) => {
    // Don't trigger if user is typing in an input
    if (
      e.target instanceof HTMLInputElement ||
      e.target instanceof HTMLTextAreaElement
    )
      return;

    const target = routes[e.key.toLowerCase()];
    if (target) {
      e.preventDefault();
      window.location.href = target;
    }
  });
</script>
