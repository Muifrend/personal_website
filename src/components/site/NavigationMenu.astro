---
const pathname = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const currentPath = normalizePath(pathname);

const links = [
  // MOBILE LINKS
  {
    href: "/feeling-lucky",
    label: "Lucky",
    mobileOnly: true,
    class: "sm:hidden group nav-link justify-center"
  },
  {
    href: "/",
    label: "Home",
    mobileOnly: true,
    class: "sm:hidden group nav-link justify-center"
  },
  {
    href: "/projects",
    label: "Projects",
    mobileOnly: true,
    class: "sm:hidden group nav-link justify-center"
  },

  // DESKTOP LINKS
  { href: "/", label: "Home", desktopOnly: true },
  { href: "/projects", label: "Projects", desktopOnly: true },
  { href: "/feeling-lucky", label: "I'm Feeling Lucky", desktopOnly: true },
];
---

<nav class="site-nav bg-white/80" aria-label="Main navigation">
  <div class="site-container h-14 flex items-center">
    <ul class="flex items-center justify-center w-auto mx-auto gap-4 sm:gap-1 list-none p-0">
      {
        links.map((link) => (
          <li class:list={[
            { "hidden sm:block": link.desktopOnly },
            { "flex sm:hidden": link.mobileOnly }
          ]}>
            <a
              href={link.href}
              class:list={[
                link.mobileOnly ? link.class : "group nav-link",
                { active: currentPath === normalizePath(link.href) },
              ]}
            >
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
