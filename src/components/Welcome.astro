---
import personalPhoto from "../assets/personal_photo.jpg";
import Resume from "../assets/Andrzej_Firek_Resume.pdf";
---

<div class="h-full font-sans relative z-10 site-container pt-24">
  <section
    class="flex flex-col-reverse md:flex-row items-start sm:items-center gap-6"
  >
    <div>
      <h1 class="text-4xl md:text-5xl font-bold leading-tight">
        Hi, I’m Andrew — an aspiring Software Engineer
      </h1>
      <p class="mt-4 text-gray-800 max-w-lg">
        As a Minerva University student with experience in robotics,
        sustainability, and global exploration, I draw on my travels to shape
        how I learn and build—motivating me to design technology that has real,
        positive impact.
      </p>
      <a
        class="mt-4 inline-block text-gray-500 hover:text-gray-700 underline font-mono"
        href={Resume}>Read my Resume →</a
      >
      <br />
      <a
        class="inline-block text-gray-500 hover:text-gray-700 underline font-mono"
        href="#contact">Get in touch →</a
      >
    </div>

    <img
      class="rounded-full self-center w-64 md:w-1/3 aspect-square object-cover"
      src={personalPhoto.src}
      alt="Personal photo of Andrew"
      fetchpriority="high"
    />
  </section>
</div>
