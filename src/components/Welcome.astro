---
import GlobeSection from "./GlobeSection";
---
<div class="h-full font-sans relative z-10 site-container pt-24">
  <section class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
    
    <div class="order-2 w-full md:order-1 md:max-w-[34rem] md:flex-1">
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 leading-none">
        Hi, I’m Andrew. <br />
        <span class="text-2xl md:text-3xl font-light text-gray-500 italic block mt-2">
          Building globally-conscious software.
        </span>
      </h1>

      <div class="mt-6 flex flex-wrap gap-2 items-center font-mono text-sm">
        <span class="px-3 py-1 bg-gray-100 rounded-full text-gray-700">minerva</span>
        <span class="text-gray-400">+</span>
        <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100">robotics</span>
        <span class="text-gray-400">+</span>
        <span class="px-3 py-1 bg-green-50 text-green-700 rounded-full border border-green-100">sustainability</span>
        <span class="text-gray-400">=></span>
        <a class="font-bold text-gray-900 underline decoration-blue-500 underline-offset-4" href="/projects">
          impactful solutions
        </a>
      </div>

      <div class="mt-8 flex flex-col items-start gap-1">
        <a class="text-gray-500 hover:text-gray-900 underline font-mono text-md transition-colors" href="/Andrzej_Firek_Resume_AI_Engineer.pdf" target="_blank">
          Read my Resume →
        </a>
        <a class="text-gray-500 hover:text-gray-900 underline font-mono text-md transition-colors" href="#contact">
          Get in touch →
        </a>
      </div>
    </div>

    <div class="order-1 self-center md:order-2 md:ml-auto aspect-square w-full max-w-96 shrink-0 sm:max-w-[27rem] md:max-w-[30rem] lg:max-w-[33rem]">
      <GlobeSection client:load />
    </div>
  </section>
</div>
