---
import { getCollection } from 'astro:content';

interface Props {
  count?: number; // Optional: limit the number of items shown
}

const { count } = Astro.props;

// 1. Fetch and Sort
const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 2. Slice the array if a count is provided (e.g., top 3)
const projects = count ? allProjects.slice(0, count) : allProjects;
---

<div class="max-w-4xl mx-auto w-full px-4 py-12 font-mono"> <div class="flex items-end border-b-2 border-black pb-2 mb-0 text-xs text-gray-500 uppercase tracking-wider">
      <div class="w-32 md:w-48 flex-shrink-0">/ Date</div>
      <div class="flex-grow">/ Name</div>
    </div>

    <div class="flex flex-col">
      {projects.map((project) => (
        <a 
          href={`/projects/${project.slug}`} 
          class="group flex items-center justify-between py-4 border-b border-gray-300 hover:bg-gray-50 transition-colors duration-200 cursor-pointer"
        >
          <div class="w-32 md:w-48 flex-shrink-0 flex items-center gap-3 text-sm text-gray-800">
            <span class="text-[10px] opacity-70">▪</span> 
            {project.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
          </div>

          <div class="flex-grow font-medium text-gray-900 group-hover:text-black">
            {project.data.title}
          </div>

          <div class="text-xl font-light text-gray-400 group-hover:text-black pl-4">
            +
          </div>
        </a>
      ))}
    </div>
</div>