---
import "../styles/global.css";
import NavigationMenu from "../components/site/NavigationMenu.astro";
import Footer from "../components/site/Footer.astro";

interface Props {
  title: string;
  contentWidth?: "wide" | "reading";
}

const { title, contentWidth = "wide" } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="min-h-screen flex flex-col bg-white font-sans antialiased">
    <header>
      <NavigationMenu />
    </header>

    <!-- This container owns the page width and gutters for content and copyright. -->
    <div class:list={[
      "site-container flex flex-1 flex-col",
      { "site-reading-container": contentWidth === "reading" },
    ]}>
      <main class="min-w-0 flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
