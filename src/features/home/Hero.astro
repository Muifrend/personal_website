---
import GlobeSection from "../globe/GlobeSection";
---
<div class="h-full font-sans relative z-10 pt-4 md:pt-24">
  <section class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
    
    <div class="order-2 min-w-0 w-full md:order-1 md:max-w-[34rem]">
      <h1 class="text-4xl md:text-6xl font-bold text-black leading-none">
        Hi, I’m Andrew. <br />
        <span class="text-2xl md:text-3xl text-black block mt-2">
          <span class="font-light">Inspired by </span><span class="font-bold">people</span
          ><span class="font-light">, </span><span class="font-bold">places</span
          ><span class="font-light">, and </span><span class="font-bold">problems</span
          ><span class="font-light"> worth solving.</span>
        </span>
      </h1>

      <div class="mt-8 flex flex-col items-start gap-1">
        <a class="text-gray-500 hover:text-gray-900 underline text-base transition-colors" href="/Andrzej_Firek_Resume_AI_Engineer.pdf" target="_blank">
          Read my Resume →
        </a>
      </div>
    </div>

    <div class="order-1 justify-self-center md:order-2 md:justify-self-end aspect-square w-full max-w-96 sm:max-w-[27rem] md:max-w-[30rem] lg:max-w-[33rem]">
      <GlobeSection client:load />
    </div>
  </section>
</div>
