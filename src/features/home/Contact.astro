---
interface Props {
  email?: string;
}

const { email = "andrzej.firek@uni.minerva.edu" } = Astro.props;
const address = email.trim();
---

<section id="contact" class="pt-12 pb-0 text-lg" aria-labelledby="contact-heading">
  <h2 id="contact-heading" class="lead-heading">
    Connect on <a
      href={`mailto:${address}`}
      class="text-blue-700 hover:underline underline-offset-4 break-all"
      >email</a
    > or <a
      href="https://www.linkedin.com/in/andrzej-firek-237bb7256/"
      class="text-blue-700 hover:underline underline-offset-4">LinkedIn</a
    >
  </h2>
  <nav class="mt-6 text-base" aria-label="Social links">
    <h3 class="text-xl">Some other links:</h3>
    <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="https://github.com/Muifrend" class="inline-flex items-center gap-2 text-blue-700 hover:underline underline-offset-4">
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-5 shrink-0 fill-current">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        GitHub
      </a>
      <a href="https://www.youtube.com/@AndrewFirek" class="inline-flex items-center gap-2 text-blue-700 hover:underline underline-offset-4">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.12C19.55 3.56 12 3.56 12 3.56s-7.55 0-9.4.52A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.12c1.85.52 9.4.52 9.4.52s7.55 0 9.4-.52a3 3 0 0 0 2.1-2.12A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.56V8.44L15.82 12 9.6 15.56Z" />
        </svg>
        YouTube
      </a>
      <a href="https://x.com/Andrew81144126" class="inline-flex items-center gap-2 text-blue-700 hover:underline underline-offset-4">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.827l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        X
      </a>
      <a href="https://www.instagram.com/andrzejarturr/" class="inline-flex items-center gap-2 text-blue-700 hover:underline underline-offset-4">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r=".8" class="fill-current stroke-none" />
        </svg>
        Instagram
      </a>
    </div>
  </nav>
</section>
