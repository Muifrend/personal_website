---
/**
 * Contact.astro
 * Reusable contact section for a homepage.
 *
 * Props:
 *  - email: string (mailto link shown)
 *  - phone: string
 *  - formAction: string (server endpoint to POST JSON to; default '/api/contact')
 *
 * This component includes a small client-side script to POST the form as JSON.
 * Replace formAction with your form endpoint (Netlify/Forms, Formspree, custom API).
 */
export let email: string = " andrzej.firek@uni.minerva.edu";
export let phone: string | null = null;
export let formAction: string = "/api/contact";
---

<section id="contact" class="py-12 px-4 text-lg">
  <div class="site-container">
    <div class="grid gap-6 md:grid-cols-2 items-start">
      <aside class="pr-6 md:pr-12" aria-labelledby="contact-info-heading">
        <h2 class="lead-heading">Contact</h2>
        <p class="text-gray-600 mt-1 py-4">
          Have a project, question, or just want to say hi? Send a message and
          I’ll get back shortly.
        </p>
        <h3 id="contact-info-heading" class="sr-only">Contact information</h3>
        <ul class="list-none p-0 m-0 mb-4">
          <li class="mb-3">
            <strong class="block pb-2">Email</strong>
            <a
              href={`mailto:${email}`}
              rel="noopener noreferrer"
              class="text-blue-600 hover:underline">{email}</a
            >
          </li>
          {
            phone ? (
              <li class="mb-3">
                <strong class="block">Phone</strong>
                <a href={`tel:${phone}`} class="text-blue-600 hover:underline">
                  {phone}
                </a>
              </li>
            ) : null
          }
        </ul>
        <strong class="block pb-2">Social</strong>
        <nav class="flex gap-3" aria-label="Social links">
          <a
            href="https://www.instagram.com/andrzejarturr/"
            aria-label="Instagram"
            title="Instagram"
            class="text-blue-600 hover:underline">Instagram</a
          >
          <a
            href="https://github.com/Muifrend"
            aria-label="GitHub"
            title="GitHub"
            class="text-blue-600 hover:underline">GitHub</a
          >
          <a
            href="https://www.linkedin.com/in/andrzej-firek-237bb7256/"
            aria-label="LinkedIn"
            title="LinkedIn"
            class="text-blue-600 hover:underline">LinkedIn</a
          >
        </nav>
      </aside>

      <form
        id="contact-form"
        class="md:col-span-1 grid gap-2"
        method="post"
        data-form-action={formAction}
        novalidate
      >
        <!-- Honeypot to deter bots -->
        <div class="sr-only">
          <label
            >Leave this field empty: <input
              name="website"
              type="text"
              autocomplete="off"
            /></label
          >
        </div>

        <label for="name" class="text-sm font-medium">Name</label>
          <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
            class="form-control"
        />

        <label for="email" class="text-sm font-medium">Email</label>
          <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
            class="form-control"
        />

        <label for="message" class="text-sm font-medium">Message</label>
          <textarea
          id="message"
          name="message"
          rows="3"
          required
            class="form-control"></textarea>

        <div class="flex gap-4 items-center mt-2">
          <button
            type="submit"
            class="bg-blue-600 text-white px-4 py-2 rounded-md"
            >Send message</button
          >
          <span
            id="contact-status"
            role="status"
            aria-live="polite"
            class="text-sm text-green-700"></span>
        </div>
      </form>
    </div>
  </div>

  <script type="module" is:inline>
    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("contact-status");

    if (!(form instanceof HTMLFormElement) || !(statusEl instanceof HTMLElement)) {
      console.warn("Contact form markup is missing expected elements.");
    } else {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const nameInput = form.querySelector('input[name="name"]');
        const emailInput = form.querySelector('input[name="email"]');
        const messageInput = form.querySelector('textarea[name="message"]');
        const honeypotInput = form.querySelector('input[name="website"]');
        const submitButton = form.querySelector('button[type="submit"]');

        if (
          !(nameInput instanceof HTMLInputElement) ||
          !(emailInput instanceof HTMLInputElement) ||
          !(messageInput instanceof HTMLTextAreaElement) ||
          !(submitButton instanceof HTMLButtonElement)
        ) {
          statusEl.textContent = "Form is unavailable. Please refresh and try again.";
          return;
        }

        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const message = messageInput.value.trim();
        const honeypot =
          honeypotInput instanceof HTMLInputElement ? honeypotInput.value.trim() : "";

        if (honeypot) {
          return;
        }

        if (!name || !email || !message) {
          statusEl.textContent = "Please complete all required fields.";
          return;
        }

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(email)) {
          statusEl.textContent = "Please enter a valid email address.";
          return;
        }

        const action = form.dataset.formAction?.trim() || "/api/contact";
        let finalStatus = "Sending…";

        submitButton.disabled = true;
        statusEl.textContent = finalStatus;

        try {
          const res = await fetch(action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, email, message }),
          });

          if (res.ok) {
            finalStatus = "Message sent. Thank you!";
            form.reset();
          } else if (res.status >= 500) {
            finalStatus = "Server issue while sending. Please try again later.";
          } else {
            finalStatus = "Could not send message. Please check your details and try again.";
          }
        } catch (err) {
          finalStatus = "Network error. Please try again in a moment.";
        } finally {
          submitButton.disabled = false;
          statusEl.textContent = finalStatus;
        }
      });
    }
  </script>
</section>
